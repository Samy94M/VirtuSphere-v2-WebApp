# VirtuSphere LDAP hermetic fixture schema (test-only).
#
# Reuses a handful of Active Directory attribute/objectClass NAMEs so the
# native LDAP adapter's filters (lib/directory_ldap.php) and its 16-byte raw
# objectGUID handling can be proven against a real slapd, not a PHP-level
# mock. This is a private, unregistered OID arc (1.3.6.1.4.1.64876) used only
# inside this hermetic, non-production fixture network; it makes no claim
# about real AD schema semantics. RootDSE-derived checks (defaultNamingContext
# lookup, dsServiceName/msDS-isRODC RODC detection) are deliberately NOT
# reproduced here: they are real-AD-only per
# docs/audits/2026-08-11-ldaps-active-directory-integration-plan.md section
# 18.3, proven against a target AD in Gate 0B instead.

attributetype ( 1.3.6.1.4.1.64876.1.1 NAME 'objectGUID'
    DESC 'VirtuSphere fixture: 16-byte raw identifier'
    EQUALITY octetStringMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.40
    SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.64876.1.2 NAME 'userPrincipalName'
    DESC 'VirtuSphere fixture: UPN'
    EQUALITY caseIgnoreMatch
    SUBSTR caseIgnoreSubstringsMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
    SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.64876.1.3 NAME 'sAMAccountName'
    DESC 'VirtuSphere fixture: sAMAccountName'
    EQUALITY caseIgnoreMatch
    SUBSTR caseIgnoreSubstringsMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
    SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.64876.1.4 NAME 'sAMAccountType'
    DESC 'VirtuSphere fixture: sAMAccountType filter token'
    EQUALITY integerMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.27
    SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.64876.1.5 NAME 'userAccountControl'
    DESC 'VirtuSphere fixture: userAccountControl bitmask'
    EQUALITY integerMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.27
    SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.64876.1.6 NAME 'accountExpires'
    DESC 'VirtuSphere fixture: accountExpires FILETIME string, "0" = never'
    EQUALITY caseIgnoreMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
    SINGLE-VALUE )

attributetype ( 1.3.6.1.4.1.64876.1.7 NAME 'objectCategory'
    DESC 'VirtuSphere fixture: objectCategory filter token'
    EQUALITY caseIgnoreMatch
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
    SINGLE-VALUE )

objectclass ( 1.3.6.1.4.1.64876.2.1 NAME 'user'
    DESC 'VirtuSphere fixture: AD-like structural user class, fixture-only'
    SUP top STRUCTURAL
    MUST ( cn $ sAMAccountName $ userPrincipalName $ objectGUID $ objectCategory )
    MAY ( sn $ displayName $ mail $ userAccountControl $ accountExpires $ sAMAccountType $ userPassword ) )
