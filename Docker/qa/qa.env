# QA-Wegwerf-Stack (Integration-Lane, ADR-0015-Ergaenzung / ADR-0031).
#
# Diese Werte sind bewusst eingecheckt und KEINE Geheimnisse: der Stack lebt
# nur fuer einen Lane-Lauf, seine Datenbank ist ein Wegwerf-Volume, MySQL
# publiziert keinen Host-Port und der Webserver bindet auf 127.0.0.1. Wer
# einen dieser Werte in einer echten Umgebung wiederverwendet, hat den Zweck
# der Datei missverstanden.
#
# Die Datei wird zweimal gelesen: als --env-file fuer die Compose-Interpolation
# (Ports, DB-Namen) und als env_file der Services (ueberschreibt .env, weil sie
# im Override nach .env gelistet ist). scripts/check.ps1 haelt die Ports und
# Containernamen als Konstanten dagegen.

APP_ENV=local
APP_BIND_IP=127.0.0.1
WEB_HTTP_PORT=8031
WEB_HTTPS_PORT=8032
PMA_PORT=8033
SSL_SUBJECT=virtusphere-qa.local
APP_PUBLIC_BASE_URL=http://127.0.0.1:8031
ANSIBLE_SOURCE_DIR=/var/www/ansible-src
VIRTUSPHERE_DEPLOY_WORKDIR=/tmp/virtusphere-deploy

DB_HOST=mysql
DB_PORT=3306
DB_NAME=deploymentcenter
DB_USER=qa_user
DB_PASS=qa-throwaway-db-password
MYSQL_ROOT_PASSWORD=qa-throwaway-root-password

# QA-only Schluessel; verschluesselte Credentials existieren nur innerhalb
# eines Lane-Laufs und sterben mit dem Volume.
APP_KEY=base64:6YkYRiCYKNgKKNmM+Cvp3m0fX+otpLs5bj43wzTxHpw=

# Der qa-stack-Schritt seedet diesen Admin und setzt must_change_password
# zurueck; die E2E-Suite meldet sich damit an (VIRTUSPHERE_ADMIN_USER/PASS
# setzt scripts/check.ps1 auf dieselben Werte).
SEED_ADMIN_USER=qa-admin
SEED_ADMIN_PASSWORD=qa-admin-password-12345
SEED_ADMIN_EMAIL=qa-admin@localhost
