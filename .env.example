APP_ENV=local
# Interface the published ports bind to. 127.0.0.1 is a DEVELOPMENT default and
# makes the portal unreachable from the LAN while the whole stack reports healthy
# and every host-local probe answers. EnvBoot does not validate this value,
# because every value is technically valid, so a production host sets its own LAN
# address here (or 0.0.0.0 for all interfaces) and verifies from a DIFFERENT
# machine. See docs/operations/go-live.md, steps 1.2 and 4.2.
APP_BIND_IP=127.0.0.1
WEB_HTTP_PORT=8021
# Public HTTPS port (WP7). Inert until an admin uploads a certificate and
# enables HTTPS in the portal; the HTTP->HTTPS redirect uses this port.
WEB_HTTPS_PORT=8022
PMA_PORT=8023
# .lan, matching every other host reference in the project. Not decoration: the
# Ansible host builds its MAC callback address from APP_PUBLIC_BASE_URL, so this
# name has to resolve in the DNS of the deploy network. Otherwise the deploy runs
# green and no MAC ever arrives. With no DNS entry, put the portal's IP here.
APP_PUBLIC_BASE_URL=http://virtusphere.lan:8021
ANSIBLE_SOURCE_DIR=/var/www/ansible-src
VIRTUSPHERE_DEPLOY_WORKDIR=/tmp/virtusphere-deploy

DB_HOST=mysql
DB_PORT=3306
DB_NAME=deploymentcenter
DB_USER=mysqluser
DB_PASS=change-me-use-a-long-random-db-password
MYSQL_ROOT_PASSWORD=change-me-use-a-long-random-root-password

# 32 random bytes, base64 encoded. Example generation:
# ubuntu: openssl rand -base64 32
# powershell: $b=New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
APP_KEY=base64:change-me-32-byte-base64-key

# First-admin seed. A fresh database contains NO user and the portal creates none,
# so exactly one of these two has to happen or nobody can sign in:
#   * set both values here, and Docker/scripts/setup.sh seeds the account,
#   * or seed it after the migrations, which keeps the password out of this file:
#     docker exec -it virtusphere-v2-webapp-php-1 \
#       php /var/www/html/lib/seed.php admin '<strong password>' admin@example.lan
# Either way the account gets must_change_password=1, and seed.php refuses to
# touch an existing user. See docs/operations/go-live.md, step 4.1.
# SEED_ADMIN_USER=admin
# SEED_ADMIN_PASSWORD=change-me-use-a-long-random-admin-password
# SEED_ADMIN_EMAIL=admin@localhost
