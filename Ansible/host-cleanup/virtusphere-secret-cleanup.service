# VirtuSphere: removes stale accounts.yml from /tmp/virtusphere-job-* (K21-F).
#
# Install with install-secret-cleanup.sh only. The installer replaces the
# placeholder @ANSIBLE_ACCOUNT@ with the Ansible account and copies this unit
# to /etc/systemd/system. Do not copy it by hand.
#
# Not a tmpfiles rule and not a lock: the script itself carries the safety
# rules (see virtusphere-secret-cleanup.sh).

[Unit]
Description=VirtuSphere: remove stale accounts.yml from job directories

[Service]
Type=oneshot
# The Ansible account that owns the job directories. Never root.
User=@ANSIBLE_ACCOUNT@
# The job directories live in the real /tmp. A private /tmp would show none.
PrivateTmp=no
NoNewPrivileges=yes
# Local sockets only (the journal through logger). The host needs no network.
RestrictAddressFamilies=AF_UNIX
ExecStart=/usr/local/libexec/virtusphere/virtusphere-secret-cleanup.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=virtusphere-secret-cleanup
