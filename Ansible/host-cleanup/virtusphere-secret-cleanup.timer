# VirtuSphere: periodic run of virtusphere-secret-cleanup.service (K21-F).
#
# The schedule only bounds how long a stale file can wait. Which file is removed
# is decided by the 24 h age in the script, the same way at every run.
#
# OnBootSec=15min: one run shortly after every boot.
# OnUnitActiveSec=1h: then hourly, so a file that reaches 24 h waits at most
# about one more hour before it is removed.
# Persistent=false: a run that was missed while the host was off is not caught
# up afterwards. OnBootSec already runs the cleanup once the host is back, and
# a backlog of missed runs would add nothing, because every run applies the
# same age test.

[Unit]
Description=VirtuSphere: periodic cleanup of stale accounts.yml

[Timer]
OnBootSec=15min
OnUnitActiveSec=1h
Persistent=false
Unit=virtusphere-secret-cleanup.service

[Install]
WantedBy=timers.target
